{"path":"tools/package_web.py","content":"\"\"\"Stage generated WASM assets and the capture script for the browser harness.\"\"\"\nimport shutil\nimport hashlib\nimport json\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef package():\n    output = ROOT / \"web/public/runtime\"\n    output.mkdir(parents=True, exist_ok=True)\n    for name in (\"python.mjs\", \"python.wasm\", \"python3.16.zip\"):\n        shutil.copy2(ROOT / \".build/wasm\" / name, output / name)\n    shutil.copy2(ROOT / \"runtime/capture.py\", output / \"capture.py\")\n    shutil.copy2(ROOT / \"cpython/LICENSE\", output / \"CPython-LICENSE.txt\")\n    digest = hashlib.sha256()\n    for name in (\"python.mjs\", \"python.wasm\", \"python3.16.zip\", \"capture.py\"):\n        digest.update(name.encode())\n        digest.update((output / name).read_bytes())\n    manifest = output / \"runtime.json.tmp\"\n    manifest.write_text(json.dumps({\"version\": digest.hexdigest(), \"revision\": (ROOT / \"runtime/revision.txt\").read_text().strip()}))\n    manifest.replace(output / \"runtime.json\")\n    print(\"Staged runtime in web/public/runtime; commit these artifacts after validation\")\n\n\nif __name__ == \"__main__\":\n    package()\n","highlightedLines":[{"version":1,"type":"root","children":[{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"\"\"\"Stage generated WASM assets and the capture script for the browser harness.\"\"\""}]},{"type":"text","value":""}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"import"}]},{"type":"text","value":" shutil"}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"import"}]},{"type":"text","value":" hashlib"}]},{"vers
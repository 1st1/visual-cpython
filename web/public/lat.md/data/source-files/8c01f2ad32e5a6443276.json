{"path":"web/source-navigation.mjs","content":"// A line visit begins when opcode execution enters it, changes frame, or loops back.\nexport function sourceVisits(events) {\n  const visits=new Map();let previous;\n  for(const event of events){\n    if(event.kind!=='opcode')continue;\n    if(event.line>0&&(!previous||event.line!==previous.line||event.frame!==previous.frame||event.offset<=previous.offset)){\n      if(!visits.has(event.line))visits.set(event.line,[]);\n      visits.get(event.line).push(event.seq);\n    }\n    previous=event;\n  }\n  return visits;\n}\nexport function nextSourceVisit(visits,line,index){\n  const entries=visits.get(line)||[];\n  return entries.find(seq=>seq>index)??entries[0];\n}\n","highlightedLines":[{"version":1,"type":"root","children":[{"type":"element","tagName":"span","properties":{"className":["hljs-comment"]},"children":[{"type":"text","value":"// A line visit begins when opcode execution enters it, changes frame, or loops back."}]},{"type":"text","value":""}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"export"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"function"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-title","function_"]},"children":[{"type":"text","value":"sourceVisits"}]},{"type":"text","value":"("},{"type":"element","tagName":"span","properties":{"className":["hljs-params"]},"children":[{"type":"text","value":"events"}]},{"type":"text","value":") {"}]},{"version":1,"type":"root","children":[{"type":"text","value":"  "},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"const"}]},{"type":"text","value":" visits="},{"type":"element","tagName":"span","properties":{"class
{"path":"tools/capture.py","content":"\"\"\"Run the native capture experiment with a parent-enforced wall-clock timeout.\"\"\"\nimport argparse\nimport json\nimport subprocess\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\n\n\ndef run(path, timeout=5):\n    interpreter = ROOT / \".build/native/python.exe\"\n    if not interpreter.exists():\n        interpreter = ROOT / \".build/native/python\"\n    try:\n        completed = subprocess.run([str(interpreter), \"-I\", str(ROOT / \"runtime/capture.py\"), str(path.resolve())],\n                                   capture_output=True, text=True, timeout=timeout, check=True)\n        return json.loads(completed.stdout)\n    except subprocess.TimeoutExpired:\n        return {\"schema\": 1, \"status\": \"timeout\", \"events\": [], \"error\": \"capture worker exceeded wall-clock budget\"}\n\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"source\", type=Path)\n    parser.add_argument(\"--output\", type=Path)\n    parser.add_argument(\"--timeout\", type=float, default=5)\n    args = parser.parse_args()\n    content = json.dumps(run(args.source, args.timeout), indent=2)\n    if args.output:\n        args.output.parent.mkdir(parents=True, exist_ok=True)\n        args.output.write_text(content + \"\\n\")\n    else:\n        print(content)\n","highlightedLines":[{"version":1,"type":"root","children":[{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"\"\"\"Run the native capture experiment with a parent-enforced wall-clock timeout.\"\"\""}]},{"type":"text","value":""}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"import"}]},{"type":"text","value":" argparse"}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span",
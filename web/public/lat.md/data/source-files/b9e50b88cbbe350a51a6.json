{"path":"tools/instrument_parser.py","content":"\"\"\"Apply bounded parser observation hooks to disposable pinned source exports.\"\"\"\nimport subprocess\nimport re\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nDECLARATIONS = '''\nextern int _XRayParserEnabled;\nextern void _XRayParserLog(int, int, int, const char *, ...);\nextern void _XRayParserRewind(int, int, int);\nextern void _XRayParserToken(int, int, int, int, const char *, int);\n'''\n\n\ndef instrument(source):\n    revision = (ROOT / 'runtime/revision.txt').read_text().strip()\n    for filename in ['Parser/parser.c', 'Parser/pegen.c', 'Python/Python-ast.c']:\n        text = subprocess.check_output(['git', '-C', str(ROOT / 'cpython'), 'show', f'{revision}:{filename}'], text=True)\n        text = text.replace('#include \"pegen.h\"', '#include \"pegen.h\"\\n' + DECLARATIONS, 1)\n        if filename.endswith('/parser.c'):\n            text = text.replace('if (p->debug)', 'if (_XRayParserEnabled)')\n            text = text.replace('D(fprintf(stderr,', 'D(_XRayParserLog(p->level, p->mark, p->fill,')\n            text = text.replace('p->mark = _mark;', '_XRayParserRewind(p->level, p->mark, _mark); p->mark = _mark;')\n        elif filename.endswith('Python-ast.c'):\n            text = text.replace('#include \"Python.h\"', '#include \"Python.h\"\\nextern void _XRayAstCreated(void *, const char *, int, int, int, int);\\nextern void _XRayAstBind(void *, PyObject *);')\n            def constructor(match):\n                body = match.group(0)\n                name = re.search(r'_PyAST_(\\w+)\\(', body)[1]\n                span = 'lineno, col_offset, end_lineno, end_col_offset' if all(name in body for name in ('int lineno', 'col_offset', 'end_lineno', 'end_col_offset')) else '0, -1, 0, -1'\n                return body.replace('    return p;', f'    _XRayAstCreated(p, \"{name}\", {span});\\n    return p;')\n            text, count = re.subn(r'\\n\\w+_ty\\n_PyAST_\\w+\\([^{{]+\\n\\{.*?\\n\\}', constructor, text, flags=re.S)\n            assert count > 50, count\n            def bind(match):\n                return match.group(0).replace('    return result;', '    _XRayAstBind(_o, result);\\n    return result;')\n            text, count = re.subn(r'ast2obj_\\w+\\(struct ast_state \\*state, void\\* _o\\)\\n\\{.*?\\n\\}', bind, text, flags=re.S)\n            assert count > 10, count\n        else:\n            needle = 'int result = initialize_token(p, t, &new_token, type);'\n            assert needle in text\n            text = text.replace(needle, needle + '''\n    if (result == 0 && _XRayParserEnabled) {\n        Py_ssize_t text_length = 0;\n        const char *text = _PyToken_TextView(p->tok, &new_token, &text_length);\n        _XRayParserToken(p->fill - 1, type, t->lineno, t->col_offset,\n                            text ? text : \"\", text ? (int)Py_MIN(text_length, 380) : 0);\n    }\n''')\n        target = source / filename\n        if target.read_text() != text:\n            target.write_text(text)\n","highlightedLines":[{"version":1,"type":"root","children":[{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"\"\"\"Apply bounded parser observation hooks to disposable pinned source exports.\"\"\""}]},{"type":"text","value":""}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"import"}]},{"type":"text","value":" subprocess"}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"import"}]},{"type":"text","value":" re"}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"from"}]},{"type":"text","value":"
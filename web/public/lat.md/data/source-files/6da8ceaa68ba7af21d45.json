etry,new THREE.MeshBasicMaterial({color,side:THREE.DoubleSide}));\n  }\n  const head=new THREE.BufferGeometry().setFromPoints([tip,base.clone().addScaledVector(normal,headWidth/2),base.clone().addScaledVector(normal,-headWidth/2)]);\n  const arrow=new THREE.Mesh(head,new THREE.MeshBasicMaterial({color,side:THREE.DoubleSide}));\n  return {line,arrow,path,color};\n}\n","highlightedLines":[{"version":1,"type":"root","children":[{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"import"}]},{"type":"text","value":" * "},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"as"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-variable","constant_"]},"children":[{"type":"text","value":"THREE"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"from"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"'three'"}]},{"type":"text","value":";"}]},{"version":1,"type":"root","children":[{"type":"text","value":""}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span","properties":{"className":["hljs-comment"]},"children":[{"type":"text","value":"// Preserve every route bend; uniform TubeGeometry sampling cuts across corners."}]},{"type":"text","value":""}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"export"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"function"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"cl
{"path":"web/programs/shortest_path.py","content":"# Breadth-first search on an unweighted graph.\ndef shortest_path(graph, start, goal):\n    queue = [start]\n    paths = {start: [start]}\n    while queue:\n        node = queue[0]\n        queue = queue[1:]\n        if node == goal:\n            return paths[node]\n        for neighbor in graph[node]:\n            if neighbor not in paths:\n                paths[neighbor] = paths[node] + [neighbor]\n                queue = queue + [neighbor]\n    return None\n\n# Two routes reach node 5; BFS finds a shortest one.\ngraph = [[1, 2], [3], [3, 4], [5], [5], []]\nprint(shortest_path(graph, 0, 5))\n","highlightedLines":[{"version":1,"type":"root","children":[{"type":"element","tagName":"span","properties":{"className":["hljs-comment"]},"children":[{"type":"text","value":"# Breadth-first search on an unweighted graph."}]},{"type":"text","value":""}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"def"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-title","function_"]},"children":[{"type":"text","value":"shortest_path"}]},{"type":"text","value":"("},{"type":"element","tagName":"span","properties":{"className":["hljs-params"]},"children":[{"type":"text","value":"graph, start, goal"}]},{"type":"text","value":"):"}]},{"version":1,"type":"root","children":[{"type":"text","value":"    queue = [start]"}]},{"version":1,"type":"root","children":[{"type":"text","value":"    paths = {start: [start]}"}]},{"version":1,"type":"root","children":[{"type":"text","value":"    "},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"while"}]},{"type":"text","value":" queue:"}]},{"version":1,"type":"root","children":[{"type":"text","value":"        node = queue["},{"type":"element","tagName":"span",
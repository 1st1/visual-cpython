{"path":"tools/test_parsing.mjs","content":"import {chromium} from 'playwright';\nimport assert from 'node:assert/strict';\nimport {readFile} from 'node:fs/promises';\nconst manifest=JSON.parse(await readFile('web/public/runtime/runtime.json','utf8'));\nconst browser=await chromium.launch({channel:'chrome',headless:true,chromiumSandbox:true});\ntry {\n  const page=await browser.newPage({viewport:{width:1500,height:1000}}),errors=[];\n  const assets=[];page.on('request',r=>{const url=new URL(r.url());if(/\\/runtime\\/(python\\.mjs|python\\.wasm|python3\\.16\\.zip|capture\\.py)$/.test(url.pathname))assets.push(url);});\n  page.on('pageerror',e=>errors.push(e.message));\n await page.addInitScript(()=>{const original=window.setTimeout;window.setTimeout=(fn,ms,...args)=>original(fn,ms===100?0:ms,...args);});\n  await page.goto(process.env.XRAY_URL || 'http://127.0.0.1:8000');\n  async function capture(source) {\n    if(await page.locator('#editor-panel').isHidden()) await page.locator('#toggle-editor').click();\n    await page.locator('.cm-content').fill(source);await page.locator('#run').click();\n    await page.waitForFunction(()=>!document.querySelector('#run').disabled,null,{timeout:60000});\n    await page.waitForFunction(()=>/Graphviz|No compiled/.test(document.querySelector('#map-status').textContent));\n  }\n  await capture('def f(x):\\n    return x+1\\nprint(f(3))');\n  assert.equal(new Set(assets.map(u=>u.pathname)).size,4);\n  for(const url of assets)assert.equal(url.searchParams.get('build'),manifest.version,'All runtime assets use the current bundle version');\n  assert.equal(await page.locator('#view-parsing, #view-execution').count(),0,'Parsing flows automatically without mode switches');\n  assert.ok(Number(await page.locator('#xray').getAttribute('data-parse-tokens'))>10);\n  assert.ok(Number(await page.locator('#xray').getAttribute('data-ast-nodes'))>10);\n  await page.waitForFunction(()=>document.querySelector('#xray').dataset.phase==='replay',null,{timeout:60000});\n  assert.equal(await page.locator('#xray').getAttribute('data-ast-visible'),'true');\n  assert.equal(await page.locator('#xray').getAttribute('data-ghost-count'),'0');\n  await page.screenshot({path:'artifacts/parsing-ast.png'});\n  await page.locator('#play').click();\n  await page.waitForFunction(()=>document.querySelector('#state').textContent==='completed',null,{timeout:60000});\n  const pipeline=await page.locator('#xray').getAttribute('data-pipeline');\n  await page.locator('#seek').focus();await page.locator('#seek').press('End');\n  assert.equal(await page.locator('#xray').getAttribute('data-pipeline'),pipeline,'Replay retains compilation geometry');\n  assert.equal(await page.locator('#stdout').textContent(),'4\\n');\n  await capture('x = (');\n  assert.equal(await page.locator('#xray').getAttribute('data-ast-nodes'),'0');\n  assert.equal(await page.locator('#xray').getAttribute('data-blocks'),'0');\n  assert.equal(await page.locator('#state').textContent(),'error');\n  assert.deepEqual(errors,[]);\n  console.log('PASS versioned runtime assets, automatic tokenizer/AST construction, execution replay, syntax failure');\n} finally {await browser.close();}\n","highlightedLines":[{"version":1,"type":"root","children":[{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"import"}]},{"type":"text","value":" {chromium} "},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"from"}]},{"type":"text","value":" "},{"type":"element","tagName":"span","properties":{"className":["hljs-string"]},"children":[{"type":"text","value":"'playwright'"}]},{"type":"text","value":";"}]},{"version":1,"type":"root","children":[{"type":"text","value":""},{"type":"element","tagName":"span","properties":{"className":["hljs-keyword"]},"children":[{"type":"text","value":"import"}]},{"type":"text","value":" assert "},{"type":"element","tagName":"span","p
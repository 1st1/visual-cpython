{"tree":{"version":1,"type":"root","children":[{"type":"element","tagName":"h1","properties":{"id":"cpython-x-ray","data-source-start-line":1,"data-source-end-line":1},"children":[{"type":"text","value":"CPython X-Ray"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":3,"data-source-end-line":5},"children":[{"type":"text","value":"An interactive 3D visualization of real CPython tokenization, PEG/AST construction,\nbytecode, and execution. Programs run in a disposable browser worker using an\ninstrumented CPython WASM build. No backend executes submitted Python."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"develop","data-source-start-line":7,"data-source-end-line":7},"children":[{"type":"text","value":"Develop"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":9,"data-source-end-line":11},"children":[{"type":"text","value":"Install Node 24 and npm. The built CPython runtime is checked in under\n"},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"web/public/runtime/"}]},{"type":"text","value":"; no Python compiler or Emscripten installation is needed\nfor frontend work."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"pre","properties":{"className":[],"data-source-start-line":13,"data-source-end-line":16},"children":[{"type":"element","tagName":"code","properties":{"className":["language-sh","hljs"]},"children":[{"type":"text","value":"npm ci\nnpm run dev\n"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":18,"data-source-end-line":18},"children":[{"type":"text","value":"Open "},{"type":"element","tagName":"a","properties":{"href":"http://127.0.0.1:8000","className":["external-link"]},"children":[{"type":"text","value":"http://127.0.0.1:8000"},{"type":"element","tagName":"span","properties":{"ariaHidden":"true","className":["external-link-icon"]},"children":[]}]},{"type":"text","value":". Vite handles modules, workers, and frontend reloads."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"build-and-deploy","data-source-start-line":20,"data-source-end-line":20},"children":[{"type":"text","value":"Build and deploy"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"pre","properties":{"className":[],"data-source-start-line":22,"data-source-end-line":25},"children":[{"type":"element","tagName":"code","properties":{"className":["language-sh","hljs"]},"children":[{"type":"text","value":"npm run build\nnpm run preview\n"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":27,"data-source-end-line":29},"children":[{"type":"text","value":"The build verifies the committed runtime and emits "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"dist/"}]},{"type":"text","value":". Development and\npreview default to the same strict port; stop one before starting the other,\nor use "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"npm run preview -- --port 8001"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":31,"data-source-end-line":34},"children":[{"type":"text","value":"Import this repository into Vercel. "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"vercel.json"}]},{"type":"text","value":" selects Vite, "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"npm run build"}]},{"type":"text","value":",\nand "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"dist"}]},{"type":"text","value":" as the output directory. No local CPython checkout or build outputs\nare needed for deployment. Python loads for Compile and Run; Graphviz loads in a separate worker when\ncompiled artifacts are ready for layout."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"rebuild-the-observation-runtime-locally","data-source-start-line":36,"data-source-end-line":36},"children":[{"type":"text","value":"Rebuild the observation runtime locally"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":38,"data-source-end-line":41},"children":[{"type":"text","value":"Only needed after changing CPython, "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"runtime/probe.c"}]},{"type":"text","value":", or parser instrumentation.\nPrerequisites: Git, a C compiler, make, host Python 3.14+, Node 24, and a CPython\ncheckout at "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"./cpython"}]},{"type":"text","value":" containing the revision in "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"runtime/revision.txt"}]},{"type":"text","value":".\nThe scripts leave that checkout unchanged and build under ignored "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":".build/"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"pre","properties":{"className":[],"data-source-start-line":43,"data-source-end-line":50},"children":[{"type":"element","tagName":"code","properties":{"className":["language-sh","hljs"]},"children":[{"type":"text","value":"python3 tools/build_native.py\npython3 cpython/Platforms/emscripten install-emscripten --emsdk-cache .build/emsdk\npython3 tools/build_wasm.py\npython3 tools/package_web.py\nnpm run check:runtime\nnpm run "},{"type":"element","tagName":"span","properties":{"className":["hljs-built_in"]},"children":[{"type":"text","value":"test"}]},{"type":"text","value":":wasm\n"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":52,"data-source-end-line":55},"children":[{"type":"text","value":"Commit the refreshed "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"web/public/runtime/"}]},{"type":"text","value":" artifacts after validation. Changes\nto "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"runtime/capture.py"}]},{"type":"text","value":" alone require repackaging, not recompiling C. The manifest\nrecords the CPython revision and content hash; frontend builds reject stale\ncapture scripts or mismatched artifacts."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":57,"data-source-end-line":58},"children":[{"type":"text","value":"Full build details and rebuild boundaries are in\n"},{"type":"element","tagName":"a","properties":{"href":"/lat.md/runtime#build-pipeline"},"children":[{"type":"text","value":"Lat's runtime documentation"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"validate","data-source-start-line":60,"data-source-end-line":60},"children":[{"type":"text","value":"Validate"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"pre","properties":{"className":[],"data-source-start-line":62,"data-source-end-line":70},"children":[{"type":"element","tagName":"code","properties":{"className":["language-sh","hljs"]},"children":[{"type":"text","value":"npm run "},{"type":"element","tagName":"span","properties":{"className":["hljs-built_in"]},"children":[{"type":"text","value":"test"}]},{"type":"text","value":":wasm\n"},{"type":"element","tagName":"span","properties":{"className":["hljs-comment"]},"children":[{"type":"text","value":"# With Vite dev or preview running and Google Chrome installed:"}]},{"type":"text","value":"\nnpm run "},{"type":"element","tagName":"span","properties":{"className":["hljs-built_in"]},"children":[{"type":"text","value":"test"}]},{"type":"text","value":":browser\nnpm run "},{"type":"element","tagName":"span","properties":{"className":["hljs-built_in"]},"children":[{"type":"text","value":"test"}]},{"type":"text","value":":xray\nnpm run "},{"type":"element","tagName":"span","properties":{"className":["hljs-built_in"]},"children":[{"type":"text","value":"test"}]},{"type":"text","value":":parsing\nnpm run "},{"type":"element","tagName":"span","properties":{"className":["hljs-built_in"]},"children":[{"type":"text","value":"test"}]},{"type":"text","value":":memory\nlat check\n"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":72,"data-source-end-line":75},"children":[{"type":"text","value":"Set "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"XRAY_URL=http://127.0.0.1:8001"}]},{"type":"text","value":" to target a preview on another port.\nScreenshots are written to ignored "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"artifacts/"}]},{"type":"text","value":". Native tests use\n"},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":".build/native/python.exe -m unittest discover -s tests -v"}]},{"type":"text","value":" (or "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"python"}]},{"type":"text","value":" where\nthat is the executable name); "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"npm run test:graph"}]},{"type":"text","value":" also uses the native build."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"what-the-trace-means","data-source-start-line":77,"data-source-end-line":77},"children":[{"type":"text","value":"What the trace means"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":79,"data-source-end-line":87},"children":[{"type":"text","value":"Operand stacks are observed "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"before"}]},{"type":"text","value":" each opcode. The parser replay records\nreal token requests, PEG checkpoints, and AST constructors. Opcode tracing\nperturbs specialization, so this is not an uninstrumented performance trace.\nCoroutine suspensions and resumptions retain activation identity. The selected\nasyncio API supports cooperative tasks and timers, without socket or thread I/O.\nPublic standard-library imports such as time, math, json, and collections are\navailable when supported by the bundled WASM runtime. Third-party imports,\nprivate attributes, classes, generators, and dynamic code remain restricted. Live history retains the latest 2,000 events without imposing a total\nexecution-event limit."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":89,"data-source-end-line":93},"children":[{"type":"text","value":"Use "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Compile"}]},{"type":"text","value":" to build source, token, AST, and opcode views without executing\nPython. "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Run/Pause"}]},{"type":"text","value":" and "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Step"}]},{"type":"text","value":" control live execution. Back and the slider\ninspect retained history; resuming returns to the live interpreter. "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Reset"}]},{"type":"text","value":"\nafter Pause clears the run while preserving compilation. Source edits require\nrecompilation. "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Stop animation"}]},{"type":"text","value":" skips construction reveal."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":95,"data-source-end-line":99},"children":[{"type":"text","value":"Drag to orbit, use the mouse/trackpad navigation setting for scroll behavior,\nand pinch to zoom the scene. The minimap offers 3D/2D, zoom, and fit controls.\nThe Inspector provides source, instructions, locals, operand stack, and output.\nMobile portrait places execution controls at the bottom; landscape aligns both\ntoolbars at the top. Mouse/trackpad choices are hidden on mobile devices."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":101,"data-source-end-line":101},"children":[{"type":"text","value":"Live stepping uses WebAssembly JSPI where available, or a shared-memory worker gate on Safari and other browsers without JSPI. Serve with the configured Vite preview or Vercel headers: "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"Cross-Origin-Opener-Policy: same-origin"}]},{"type":"text","value":", "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"Cross-Origin-Embedder-Policy: require-corp"}]},{"type":"text","value":", and "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"Cross-Origin-Resource-Policy: same-origin"}]},{"type":"text","value":". A plain static server without these headers cannot provide the Safari fallback."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":103,"data-source-end-line":103},"children":[{"type":"text","value":"For the Safari-engine regression test, install WebKit with "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"npx playwright install webkit"}]},{"type":"text","value":", then run "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"npm run test:safari"}]},{"type":"text","value":" against the running app. "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"XRAY_URL"}]},{"type":"text","value":" can point it at a production preview."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{"data-source-start-line":105,"data-source-end-line":107},"children":[{"type":"text","value":"Custom programs support up to 256 Python tokens and 16 KiB of source. Edit uses\nCodeMirror with Tab indentation and inline compilation errors. Share opens a\ncopyable gzip/base64url link; opening it previews the source without running it."}]}]},"title":"CPython X-Ray","path":"@/README.md","gitTree":null,"tableOfContents":[{"id":"cpython-x-ray","title":"CPython X-Ray","depth":1,"errorCount":0,"hasGitChanges":false},{"id":"develop","title":"Develop","depth":2,"errorCount":0,"hasGitChanges":false},{"id":"build-and-deploy","title":"Build and deploy","depth":2,"errorCount":0,"hasGitChanges":false},{"id":"rebuild-the-observation-runtime-locally","title":"Rebuild the observation runtime locally","depth":2,"errorCount":0,"hasGitChanges":false},{"id":"validate","title":"Validate","depth":2,"errorCount":0,"hasGitChanges":false},{"id":"what-the-trace-means","title":"What the trace means","depth":2,"errorCount":0,"hasGitChanges":false}],"graphNodeIds":{},"errors":[],"backReferences":[],"frontmatter":{"requireCodeMention":false}}

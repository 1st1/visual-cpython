{
  "name": "cpython-xray",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/check_runtime.mjs && vite",
    "build": "node tools/check_runtime.mjs && vite build",
    "preview": "vite preview",
    "check:runtime": "node tools/check_runtime.mjs",
    "test:memory": "node tools/test_memory.mjs",
    "test:xray": "node tools/test_xray.mjs",
    "test:graph": "node tools/test_graph.mjs",
    "test:browser": "node tools/test_browser.mjs",
    "test:live": "node --experimental-wasm-jspi tools/test_live_runtime.mjs && node tools/test_live_execution.mjs",
    "test:safari": "node tools/test_safari.mjs",
    "test:wasm": "node tools/test_wasm.mjs",
    "test:parsing": "node tools/test_parsing.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@viz-js/viz": "3.31.0",
    "codemirror": "6.0.2",
    "three": "0.186.1"
  },
  "engines": {
    "node": ">=24"
  }
}
